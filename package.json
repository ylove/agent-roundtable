{
  "name": "agent-roundtable",
  "version": "1.0.0",
  "description": "MCP server for meetings and collaborations between AI agents — Anthropic, OpenAI, Together AI, Replicate, Ollama, or any OpenAI-compatible endpoint",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agent-roundtable": "dist/index.js",
    "roundtable": "dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ylove/agent-roundtable.git"
  },
  "homepage": "https://github.com/ylove/agent-roundtable#readme",
  "bugs": {
    "url": "https://github.com/ylove/agent-roundtable/issues"
  },
  "files": [
    "dist",
    "examples",
    "docs",
    ".env.example",
    "SECURITY.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agents",
    "multi-agent",
    "llm",
    "claude-code"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "pretest": "npm run build",
    "test": "npm run test:unit && npm run test:smoke",
    "test:unit": "node --import ./test/fixtures/foundation/test-env.mjs --test test/unit/*.test.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:live": "node test/live-smoke.mjs",
    "version": "node scripts/sync-version.mjs && git add server.json .claude-plugin plugins src/config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dotenv": "^18.0.7",
    "undici": "7.30.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  },
  "mcpName": "io.github.ylove/agent-roundtable"
}
