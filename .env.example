# agent-roundtable — copy to .env and fill in the keys you have.
#
# .env is loaded from the package directory (next to package.json) with
# override: true, so values here win over anything the MCP host passes in its
# env block. .env is gitignored and is the single source of truth for secrets.
# Every variable is optional: a missing key fails only the calls that need it.

# --- Provider keys (secrets; leave blank for providers you do not use) ---

# Required for provider "anthropic".
ANTHROPIC_API_KEY=

# Required for provider "openai".
OPENAI_API_KEY=

# Required for provider "together".
TOGETHER_API_KEY=

# Required for provider "replicate".
REPLICATE_API_TOKEN=

# --- OpenAI-compatible endpoint (LM Studio, vLLM, llama.cpp server, OpenRouter, Groq, Fireworks, ...) ---

# Required for provider "openai_compatible" unless base_url is passed per call.
OPENAI_COMPATIBLE_BASE_URL=

# Optional. When unset, the Authorization header is omitted. When set, it is sent as the bearer
# token to whichever base URL is used — including a base_url passed per call.
OPENAI_COMPATIBLE_API_KEY=

# Model id sent to the openai_compatible endpoint. Default: default
OPENAI_COMPATIBLE_MODEL=default

# --- Ollama ---

# Required for provider "ollama"; only usable when GET $OLLAMA_URL/api/tags answers within 1 s.
# Default: http://localhost:11434
OLLAMA_URL=http://localhost:11434

# --- Agent personas ---

# Directory for agent prompt lookup (<dir>/<agent>.md, <dir>/subagent-<agent>.md, <dir>/<agent>/AGENT.md).
# Default: .claude/agents, relative to the server's working directory — use an absolute path.
ROUNDTABLE_AGENTS_DIR=.claude/agents

# Skill lookup: personal ~/.claude/skills, then project .claude/skills beside an agent in
# .claude/agents, then this directory. Found skills are reused, never overwritten or shadowed.
# New create skills go here; new improve skills go beside a target in its project's .claude/skills
# when the target sits in .claude/agents, otherwise here. Results report actual paths.
# Default: skills beside the agents dir (normally .claude/skills).
# ROUNDTABLE_SKILLS_DIR=.claude/skills

# Workspace excerpts for private conversation grounding. Default: project containing .claude/agents,
# otherwise the server working directory. Grounding sends excerpts to the session's provider.
# ROUNDTABLE_WORKSPACE_DIR=

# Locally stored session activity log. Default: ~/.agent-roundtable/activity.jsonl
# Set off, false, 0 or no to disable. Private conversation grounding and private improve_agent
# contributor prompts send recent topics/outcomes to the provider. Public improve prompts never
# include the target's recent activity; public conversations never receive grounding.
# ROUNDTABLE_ACTIVITY_LOG=

# Concurrent participant calls for ultraplan phases and agent workshop reviews. Default: 4 (minimum 1).
# ROUNDTABLE_PARALLEL_TURNS=4

# --- Default models (id or, for Anthropic, the alias "opus" / "sonnet") ---

# Default: claude-opus-5
ROUNDTABLE_ANTHROPIC_MODEL=claude-opus-5

# Default: gpt-5.6-luna
ROUNDTABLE_OPENAI_MODEL=gpt-5.6-luna

# Default: zai-org/GLM-5.3
ROUNDTABLE_TOGETHER_MODEL=zai-org/GLM-5.3

# Default: qwen/qwen3-235b-a22b-instruct-2507
ROUNDTABLE_REPLICATE_MODEL=qwen/qwen3-235b-a22b-instruct-2507

# Default: qwen3:14b
ROUNDTABLE_OLLAMA_MODEL=qwen3:14b

# --- Limits ---

# Max output tokens per call (thinking tokens count). Default: 8192
ROUNDTABLE_MAX_TOKENS=8192

# Per-request timeout in milliseconds for every provider call. Default: 600000 (10 min)
ROUNDTABLE_LLM_TIMEOUT_MS=600000

# --- Public sessions ---
# Only used when a session is started with public: true. Session turns and summaries are posted to
# a world-readable channel; context and personas are never posted. Workshops post contributions,
# reviews and a redacted definition summary without its system prompt or skill instructions.
# Nothing is posted for ordinary sessions.

# Publisher backend: ntfy (default) or webhook
ROUNDTABLE_PUBLISHER=ntfy

# ntfy server. Anonymous ntfy.sh allows 250 messages/day (burst 60, then 1 per 5 s) and keeps 12 h of history.
# Default: https://ntfy.sh
ROUNDTABLE_NTFY_URL=https://ntfy.sh

# Optional ntfy auth: an access token, or a user + password (token wins). Leave unset for anonymous.
# ROUNDTABLE_NTFY_TOKEN=
# ROUNDTABLE_NTFY_USER=
# ROUNDTABLE_NTFY_PASSWORD=

# Webhook publisher (ROUNDTABLE_PUBLISHER=webhook): each entry is POSTed here as JSON.
# ROUNDTABLE_WEBHOOK_URL=
# Viewing URL shown to the human; "{channel}" is replaced with the channel id.
# ROUNDTABLE_WEBHOOK_VIEW_URL=
# Value sent as the Authorization header, e.g. "Bearer abc123".
# ROUNDTABLE_WEBHOOK_AUTH_HEADER=

# Prefix of generated channel names (the rest is random, never derived from the topic). Default: roundtable
ROUNDTABLE_PUBLIC_TOPIC_PREFIX=roundtable

# Where transcripts are saved when a public session ends.
# Default: ~/.agent-roundtable/transcripts
# ROUNDTABLE_TRANSCRIPTS_DIR=

# Max time to wait for pending posts when a public session ends, in milliseconds. Default: 30000
ROUNDTABLE_PUBLISH_FLUSH_TIMEOUT_MS=30000

# --- Prototype mode ---
# Only used when a session is started with prototype: true. Agents' prototypes are written to a
# sandbox, shown on a read-only board at http://127.0.0.1:<port>/<token>/ (a random capability
# token), and destroyed once assessed. SQL, IaC and other code prototypes are never executed. A web
# prototype's JavaScript runs only in a sandboxed, opaque-origin frame in your browser and, in public
# sessions, in a headless Chrome that can reach nothing but the prototype's own files.

# Sandbox root. Refused if inside a git work tree, if it is a symlink, or if another user owns it;
# created with mode 0700. Default: <os temp dir>/agent-roundtable-prototypes
# ROUNDTABLE_PROTOTYPE_DIR=

# Safety cap: a prototype still under assessment after this long is destroyed, in milliseconds.
# Values below 60000 are raised to 60000. Default: 1800000 (30 min)
# ROUNDTABLE_PROTOTYPE_TTL_MS=1800000

# Open the board in a browser at session start. Default: off. Set to 1 (or true, yes, on) to enable.
# ROUNDTABLE_PROTOTYPE_OPEN=1

# Chrome/Chromium binary used for screenshots in public prototype sessions.
# Default: auto-detect the Google Chrome or Chromium app, then google-chrome, google-chrome-stable,
# chromium or chromium-browser on PATH.
# ROUNDTABLE_CHROME_PATH=

# Screenshots of web prototypes (desktop and mobile), posted as attachments in public prototype
# sessions only; diagrams get a mermaid.live link instead. Default: on. Set to 0 (or false, no, off)
# to disable.
# ROUNDTABLE_PROTOTYPE_SCREENSHOTS=1
