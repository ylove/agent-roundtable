{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.ylove/agent-roundtable",
  "description": "Multi-agent meetings, duels and collaborations across LLM providers, with heads-down execution.",
  "repository": {
    "url": "https://github.com/ylove/agent-roundtable",
    "source": "github"
  },
  "version": "2.0.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "agent-roundtable",
      "version": "2.0.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "environmentVariables": [
        {
          "name": "ANTHROPIC_API_KEY",
          "description": "Anthropic API key (optional)",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "OPENAI_API_KEY",
          "description": "OpenAI API key (optional)",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "TOGETHER_API_KEY",
          "description": "Together AI API key (optional)",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "REPLICATE_API_TOKEN",
          "description": "Replicate API token (optional)",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
