      "files": [
        {
          "path": "index.html",
          "content": "<!doctype html><html lang=\"en\"><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Ten Coins</title><style>body{font:20px system-ui;padding:20px;background:#f1fff7;color:#153b29}button{font:inherit;margin:8px;padding:12px}output{display:block}</style><h1>Ten Coins</h1><p>You have 10 coins. Buy lunch (3) and a bus ride (2). Decide whether a toy (6) fits. Finish in 60 seconds.</p><output id=\"status\" aria-live=\"polite\"></output><button id=\"lunch\">Lunch: 3</button><button id=\"bus\">Bus: 2</button><button id=\"toy\">Toy: 6</button><button id=\"restart\">Restart</button><script>let coins,needs,over,timer;const status=document.getElementById('status');function show(message=''){status.textContent=message+' Coins left: '+coins;}function reset(){clearTimeout(timer);coins=10;needs=new Set();over=false;show('Choose your needs first.');timer=setTimeout(()=>{over=true;show('Time! Try again.');},60000);}for(const [id,cost] of [['lunch',3],['bus',2],['toy',6]])document.getElementById(id).onclick=()=>{if(over)return;if(needs.has(id))return show('Already bought.');if(cost>coins)return show('Too expensive. Save for needs.');coins-=cost;needs.add(id);if(needs.has('lunch')&&needs.has('bus')){over=true;clearTimeout(timer);show('You covered your needs and saved '+coins+'!');}else show('Good choice? Remember both needs.');};document.getElementById('restart').onclick=reset;reset();</script></html>"
        }
      ]
    },
    {
      "eventIndex": 6,
      "team": "B",
      "files": [
        {
          "path": "index.html",
          "content": "<!doctype html><html lang=\"en\"><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Goal Jar</title><style>body{font:20px system-ui;padding:20px;background:#fff7e7;color:#423015}button{font:inherit;margin:8px;padding:12px}output{display:block}</style><h1>Goal Jar</h1><p>Five days, two coins a day. Save 5 for a book. Will you save or buy a snack? Finish in 60 seconds.</p><output id=\"status\" aria-live=\"polite\"></output><button id=\"save\">Save 2</button><button id=\"snack\">Snack: save 1</button><button id=\"restart\">Restart</button><script>let day,coins,over,timer;const status=document.getElementById('status');function show(){status.textContent='Day '+day+'/5. Jar: '+coins+' coins.'+(over?(coins>=5?' Book goal reached!':' Try saving more.'):'');}function choose(amount){if(over)return;coins+=amount;day++;over=day===5;if(over)clearTimeout(timer);show();}function reset(){clearTimeout(timer);day=0;coins=0;over=false;show();timer=setTimeout(()=>{over=true;show();},60000);}document.getElementById('save').onclick=()=>choose(2);document.getElementById('snack').onclick=()=>choose(1);document.getElementById('restart').onclick=reset;reset();</script></html>"
        }
      ]
    }
  ]
